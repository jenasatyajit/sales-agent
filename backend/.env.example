# Sarvam AI key — powers STT (saaras:v4), LLM (sarvam-105b) and TTS (bulbul:v4-flash)
SARVAM_API_KEY=

# Async SQLAlchemy URL. Keep the DB file on the Linux VM's own filesystem for reliable
# writes (see BACKEND.md §1.2 — mounted Windows paths can misbehave under load).
DATABASE_URL=sqlite+aiosqlite:///./pitch_simulator.db

# uvicorn bind address. 0.0.0.0 so the Windows browser and Next.js dev server can reach the VM.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Next.js dev origin(s) allowed by CORS. Comma-separated if you need more than one.
ALLOWED_ORIGIN=http://localhost:3000
